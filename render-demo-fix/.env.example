# Local development uses SQLite. Set DATABASE_URL to managed PostgreSQL for Vercel.
DATABASE_URL=

API_PORT=8000
UI_PORT=8501
API_HOST=0.0.0.0
CACHE_TTL=300

# ─── Alert Recipients ────────────────────────────────
ALERT_EMAIL=ops@yourcompany.com
DEMO_ALERTS_ENABLED=false

# ─── Real-World Data APIs ─────────────────────────────
# Get a free key at https://newsapi.org
NEWS_API_KEY=your_newsapi_key_here
# Get a free key at https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_key_here

# ─── AI / LLM ────────────────────────────────────────
# Get a free key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Email Alerts (SMTP) ─────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# ─── Slack Alerts ────────────────────────────────────
# Create a webhook at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# ─── Optional Carrier Reroute Webhook ──────────────────
# Real carrier: use a company-controlled adapter that returns {"status":"confirmed", "route_id":"R5"}.
# Local demo: run `python run_mock_carrier.py`, then set CARRIER_WEBHOOK_URL=http://127.0.0.1:8010/carrier/reroute.
CARRIER_WEBHOOK_URL=
CARRIER_API_TOKEN=
CARRIER_WEBHOOK_TIMEOUT=8
